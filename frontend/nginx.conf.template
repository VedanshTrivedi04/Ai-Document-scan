server {
    listen 80;
    listen 10000;
    root /usr/share/nginx/html;
    index index.html;

    resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

    # Request-body ceilings at the proxy, an outer backstop only. The API
    # enforces each company's own upload limits (companies.max_file_size_mb /
    # max_zip_size_mb, set by a platform admin) with specific messages, so these
    # must be at least as large as the LARGEST limit any company is given.
    # They are set by env vars (defaults in the Dockerfile).
    # UPLOAD_BODY_LIMIT covers single-document uploads (multipart: largest
    # per-file limit + ~1 MB). BULK_UPLOAD_BODY_LIMIT covers bulk zips.
    client_max_body_size ${UPLOAD_BODY_LIMIT};

    # Bulk zips: streamed straight through (no buffering at the proxy), so the
    # API can refuse an over-limit zip from its Content-Length at once.
    location /api/bulk-uploads {
        client_max_body_size ${BULK_UPLOAD_BODY_LIMIT};
        proxy_request_buffering off;
        proxy_pass ${API_UPSTREAM}/bulk-uploads;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }


    # /api/* -> backend, with the /api prefix stripped (same as the Vite dev proxy).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }


    # nginx's default mime.types has no .mjs entry; browsers refuse to run module scripts
    # (the pdf.js worker) served as application/octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
    }

    # Hashed static assets can be cached aggressively
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: unknown paths fall back to index.html.
    # index.html must not be cached so browser always picks up new releases.
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri $uri/ /index.html;
    }
}

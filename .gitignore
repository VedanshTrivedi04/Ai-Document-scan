# =============================================================================
# Gitignore for Document Authenticator Tool (FDDT)
# =============================================================================

# --- Environment & Secret files (CRITICAL: NEVER COMMIT SECRETS) ---
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!*.env.example
!**/.env.example

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
**/.venv/
**/venv/

# --- Node & Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Logs ---
logs/
*.log
backend/*.log
uvicorn*.log
celery*.log

# --- Database & Local runtime state ---
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# --- Docker local overrides ---
docker-compose.override.yml
docker-compose.*.local.yml

# --- IDE & OS files ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Private keys & Certificates ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
*.id_rsa

# Local zip bundles at the repo root (docs exports, bulk upload test archives)
/*.zip

# Regression harness input cache (client PDFs, OCR results) — never committed
backend/tests/regression/_cache/

# Free local providers (backend/.env STORAGE_PROVIDER=local, OCR_PROVIDER=local)
backend/local_storage/
backend/tessdata/
backend/models/
*.onnx

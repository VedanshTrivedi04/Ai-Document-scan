# Copy this file to `.env` in the backend/ directory and fill in real
# values for local development. Never commit the real `.env` file.

# --- General ---
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
# OWNER connection — used by `alembic upgrade head` and seed.py only. Must
# match the postgres service in the root docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://docauth:docauth@localhost:5432/docauth
# The two roles the running app connects as (same host/db as DATABASE_URL).
# The multi-tenancy migration creates them with these passwords:
#  - app role: NOSUPERUSER NOBYPASSRLS — every company-scoped query; confined
#    to one company by PostgreSQL Row-Level Security.
#  - platform role: BYPASSRLS — sign-in lookup and platform-admin screens only.
# Use long random passwords anywhere but local dev.
DATABASE_APP_USER=fddt_app
DATABASE_APP_PASSWORD=fddt_app_local
DATABASE_PLATFORM_USER=fddt_platform
DATABASE_PLATFORM_PASSWORD=fddt_platform_local
# Connect the two app roles through PgBouncer (transaction pooling, see
# pgbouncer/pgbouncer.ini and docker-compose.yml). When set, each process keeps
# NO pool of its own. Leave unset to connect directly with a small per-process
# pool (DB_POOL_SIZE + DB_MAX_OVERFLOW per role, must be >= worker threads).
# Arithmetic: docs/processing-queues.md, "Database connections".
# DATABASE_POOLER_HOST=localhost
# DATABASE_POOLER_PORT=6432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Multi-tenancy ---
# Company the pre-multi-tenancy data is assigned to by the migration.
DEFAULT_COMPANY_NAME=Default Company
# Platform-admin reads of company data are audited in PLATFORM-ONLY rows (never
# visible to the company). 0 = record every single access (default); a value
# > 0 collapses identical reads by the same admin within that many seconds.
PLATFORM_ACCESS_AUDIT_DEDUP_SECONDS=0

# --- Uploads ---
# Upload limits are PER COMPANY (Platform > Companies > Edit; stored on the
# company row). These are only the limits a NEW company is created with;
# changing them later never changes an existing company.
DEFAULT_MAX_FILE_SIZE_MB=10
DEFAULT_MAX_ZIP_SIZE_MB=300

# --- Processing queues / rate limits (see app/tasks/celery_app.py) ---
# Global ceilings across ALL workers (Redis-backed), applied per API call.
AZURE_DOCUMENT_INTELLIGENCE_MAX_CALLS_PER_SECOND=10
# Layout's font-style add-on (billed per page): font estimates for scanned
# pages, used by the font consistency check. false = fonts on scans are left
# to the visual review only.
AZURE_DOCUMENT_INTELLIGENCE_STYLE_FONT=true
# Set to ~80% of your Azure OpenAI deployment's quotas (Azure portal >
# deployment > Rate limit, or the x-ratelimit-limit-requests / -tokens response
# headers). Tokens are usually the binding limit for vision calls: Azure counts
# each request's prompt plus its full max_tokens reservation against TPM.
AZURE_OPENAI_MAX_REQUESTS_PER_MINUTE=60
AZURE_OPENAI_MAX_TOKENS_PER_MINUTE=0
# Worker pool sizes (start-worker.sh). 0 for forensics = one per CPU core.
EXTRACTION_WORKER_CONCURRENCY=4
VISION_WORKER_CONCURRENCY=4
FORENSICS_WORKER_CONCURRENCY=0
# Fair-share scheduling: a company's tasks drop one priority level per this
# many outstanding tasks on a queue (smaller = newcomers overtake big batches
# sooner).
FAIR_SHARE_BUCKET_SIZE=5
# queue_metrics logs a WARNING `queue_alert {json}` line when a queue's oldest
# waiting task is older than this many seconds (0 = off). Alert on it in your
# log platform.
QUEUE_ALERT_OLDEST_WAITING_SECONDS=300
# Nightly usage-counter reconciliation hour (UTC).
USAGE_RECONCILIATION_HOUR_UTC=2
# Stuck-document recovery (every 5 min, only while the extraction queue is
# empty and idle): re-queue documents pending/processing longer than this,
# at most MAX_REQUEUES times, then mark them failed. 0 disables that check.
STUCK_DOCUMENT_PENDING_MINUTES=10
STUCK_DOCUMENT_PROCESSING_MINUTES=30
STUCK_DOCUMENT_MAX_REQUEUES=3

# --- Sign-in throttling (Redis; fails open if Redis is down) ---
# Failed sign-ins per email address before a lockout, and its length.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Attempts per client IP per minute (any outcome). 0 disables.
LOGIN_MAX_ATTEMPTS_PER_IP_PER_MINUTE=20

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents

# --- Azure Document Intelligence (OCR / layout) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Azure AI Vision (signature/stamp detection, logo matching) ---
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_KEY=

# --- Azure OpenAI (classification/extraction and vision review — see
# app/services/llm_service.py) ---
# Either the classic resource endpoint (https://<resource>.openai.azure.com/)
# or an Azure AI Foundry project endpoint copied from the Foundry portal
# (https://<resource>.services.ai.azure.com/api/projects/<name>) — both work.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=60.0

# --- Issuer registry fuzzy matching (rapidfuzz) ---
ISSUER_FUZZY_MATCH_THRESHOLD=85.0

# --- Metadata forensics (pikepdf/PyMuPDF) ---
# A file modified after it was created is flagged; this is only the timestamp
# jitter tolerance in seconds (PDF dates are whole seconds).
METADATA_FORENSICS_MOD_DATE_THRESHOLD_SECONDS=1.0
METADATA_FORENSICS_EDITING_SOFTWARE_NAMES=photoshop,gimp,illustrator,affinity,coreldraw,paint.net,pixlr,canva,inkscape
METADATA_FORENSICS_PDF_EDITOR_NAMES=ilovepdf,smallpdf,sejda,pdfescape,pdf-xchange editor,phantompdf,foxit pdf editor,nitro pro,nitro pdf pro,pdfelement,soda pdf,sodapdf,pdffiller,dochub,pdfcandy,pdf candy

# --- Duplicate/near-duplicate detection (imagehash pHash) ---
DUPLICATE_HASH_HAMMING_THRESHOLD=5

# --- Cloud AI-content-detection API (Azure AI Content Safety / Hive) ---
AI_CONTENT_DETECTION_ENDPOINT=
AI_CONTENT_DETECTION_KEY=

# --- Transactional email (Azure Communication Services or similar) ---
EMAIL_SERVICE_CONNECTION_STRING=
EMAIL_FROM_ADDRESS=

# --- docker-compose overrides (optional; defaults shown) ---
POSTGRES_USER=docauth
POSTGRES_PASSWORD=docauth
POSTGRES_DB=docauth
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Translation (app/services/translation_service.py) ---
# Google Cloud Translation API key (Cloud Translation - Basic, v2). Optional:
# without it the app offers English and Hindi; other languages fall back to
# English. Only fixed message templates and labels are sent for translation,
# never a person's details.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=8.0

# --- Organisation subdomains (app/services/subdomains.py) ---
# The domain each organisation sits one label below, e.g. example.org makes
# indore.example.org the sign-in page of the organisation "indore". For local
# development use "localhost" (browsers resolve indore.localhost to this
# machine). Leave empty to rely on the X-Org-Subdomain header alone.
APP_BASE_DOMAIN=

# --- Running without Azure: free substitutes for development and demos ---
# Leave these three at "azure" to use the Azure services configured above.
#
# STORAGE_PROVIDER=local keeps uploaded files on this machine's disk.
STORAGE_PROVIDER=azure
LOCAL_STORAGE_DIR=./local_storage
# Where the browser reaches GET /files ("/api/files" = through the frontend's dev proxy).
LOCAL_STORAGE_PUBLIC_URL=/api/files
#
# OCR_PROVIDER=local reads a PDF's own text, and uses Tesseract for scans and
# images. TESSDATA_DIR is the folder with Tesseract's .traineddata files, one
# per language named in OCR_LANGUAGES.
OCR_PROVIDER=azure
TESSDATA_DIR=
# Path to tesseract.exe when it is not on PATH (found automatically in the usual Windows folder).
TESSERACT_CMD=
OCR_LANGUAGES=eng+hin
#
# LLM_PROVIDER=openai_compatible uses any OpenAI-compatible chat API. Text
# only: the image-based checks of invoice cases are not available with it.
#   Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                  LLM_API_KEY=<key from Google AI Studio>   LLM_MODEL=<a Gemini model name>
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=gemma3   (no key)
LLM_PROVIDER=azure
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=120
